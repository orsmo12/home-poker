# Copy to `.env.local` for local development (or edit .env.production for the live build).
# All of these are optional: with everything empty the app is 100% local and works offline.

# Anonymous usage analytics — https://eu.posthog.com (Project settings → Project API key)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Public address of the site (used in shared messages and invite links)
VITE_APP_URL=

# Optional cloud module — Supabase → Project Settings → API ("Project URL" and the "anon public" key)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional push notifications — public VAPID key (the private key is a Supabase Edge Function secret)
VITE_VAPID_PUBLIC_KEY=

# Optional: enable sign-in with an emailed code (needs custom SMTP in Supabase)
VITE_AUTH_EMAIL=
